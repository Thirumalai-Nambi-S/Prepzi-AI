# --- Groq (replaces Gemini) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Firebase Admin (server-side) ---
# Option A (recommended for local dev): path to the service account JSON file
# Download it from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json

# Option B: instead of a file, you can set these three individually (useful for deployment)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# --- App / cookie config ---
SESSION_COOKIE_NAME=session
SESSION_EXPIRES_DAYS=7
# Comma-separated list of allowed origins for CORS (the Next.js dev server)
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
